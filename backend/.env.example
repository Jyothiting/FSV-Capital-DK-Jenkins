# Copy to backend/.env and adjust values for your machine.
# cp .env.example .env

# MySQL (required for normal use)
# Password with @ must be URL-encoded as %40 (e.g. abc@1237 -> abc%401237)
DATABASE_URL=mysql+pymysql://fsv_user:YOUR_PASSWORD@localhost:3306/fsv_capital?charset=utf8mb4

# Optional: use SQLite only for quick local testing without MySQL
# DATABASE_URL=sqlite:///./fsv_capital.db

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM / RAG (optional — enables GPT-powered Q&A, deal insights, form coach)
# Prefer gitignored .env.local for secrets: cp .env.local.example .env.local
# OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=auto
# LLM_TEMPERATURE=0.2
